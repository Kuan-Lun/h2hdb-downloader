#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

primary="$(scripts/detect-primary-branch.sh)"
current="$(git branch --show-current)"
[[ "$current" == "$primary" ]] || {
    printf 'Merge commits are permitted only on primary: %s\n' "$primary" >&2
    exit 1
}

scripts/check-version.py --index
profile="$(.venv/bin/python scripts/check_change_scope.py --index --base HEAD)"
case "$profile" in
    documentation)
        exec .venv/bin/python scripts/check-docs.py --index --base HEAD
        ;;
    full)
        exec scripts/check-full.sh
        ;;
    *)
        printf 'Unrecognized check profile: %s\n' "$profile" >&2
        exit 1
        ;;
esac
