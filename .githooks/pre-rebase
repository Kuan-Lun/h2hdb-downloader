#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

primary="$(scripts/detect-primary-branch.sh)"
rebased_branch="${2:-$(git symbolic-ref --quiet HEAD || true)}"
if [[ "${rebased_branch#refs/heads/}" == "$primary" ]]; then
    printf 'Rebasing primary is not allowed: %s; preserve task merge commits.\n' \
        "$primary" >&2
    exit 1
fi
